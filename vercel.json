{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/app", "destination": "/api/app" },
    { "source": "/app/:path*", "destination": "/api/app/:path*" },
    { "source": "/assets/:path*", "destination": "/api/assets/:path*" },
    { "source": "/files/:path*", "destination": "/api/files/:path*" },
    { "source": "/private/:path*", "destination": "/api/private/:path*" },
    { "source": "/logout", "destination": "/api/logout" },
    {
      "source": "/((?!api/|app|assets/|files/|private/|logout|static/|catalog_images/|site-images/|favicon|robots|sitemap|llms).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/catalog_images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/site-images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
