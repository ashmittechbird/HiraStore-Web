{
  "name": "hira-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && yarn deploy",
    "build:frappe": "VITE_CATALOG_BASE=/assets/hira/catalog_images vite build --base /assets/hira/hirastore/",
    "deploy": "rm -rf ../hirastore/public/store/assets/* && mkdir -p ../hirastore/public/store/assets ../hirastore/www/store && cp -r dist/assets/. ../hirastore/public/store/assets/ && cp dist/index.html ../hirastore/www/store/index.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "frappe-react-sdk": "^1.4.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5",
    "vite": "^5.4.21"
  }
}
