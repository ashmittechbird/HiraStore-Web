# Copy to .env.local for local development. Every value is optional —
# with none of them set the storefront runs on its bundled catalogue.

# ── Frappe / ERPNext backend ────────────────────────────────────────────────
# Where the Vite dev server proxies /api and /files. Point this at your bench.
# VITE_FRAPPE_URL=http://192.168.1.50:8001

# On Vercel set this one instead (server-side, used by api/[...path].js).
# Leave it unset and the deploy runs in demo mode with the bundled catalogue.
# FRAPPE_URL=https://erp.yourdomain.com

# Only for multi-tenant benches whose site name differs from the host above,
# e.g. a bench reached by IP that serves the site 'hirastore.local'.
# FRAPPE_SITE_NAME=hirastore.local

# ── Overrides ───────────────────────────────────────────────────────────────
# Force a mode instead of probing the backend: demo | frappe
# VITE_BACKEND_MODE=demo

# Override the deploy base path (defaults: /store/ in dev, / on Vercel,
# /assets/hirastore/store/ for the Frappe build).
# VITE_BASE=/store/

# Override the store WhatsApp number (international format, digits only).
# The number is baked into the build; Admin > Settings still overrides both.
# VITE_WHATSAPP_NUMBER=19726556599

# Serve product photos from somewhere else (a CDN, or Frappe's asset path).
# VITE_CATALOG_BASE=/assets/hira/catalog_images
